# Nessun segreto reale nel repository. Per l'alpha senza Supabase basta npm run dev.
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Progetto indicato dal committente. Completare tutti i valori prima di creare .env.
# Dashboard Supabase > Connect / Settings > API Keys. NON usare service_role o sb_secret.
SUPABASE_URL=https://mxaogzjquvhwurngktyz.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Abilitare solo dopo configurazione e collaudo del provider Google in Supabase.
GOOGLE_AUTH_ENABLED=false
DATABASE_URL=
# Per serverless: CA pubblica PEM in base64; non utilizzare percorsi Windows sul cloud.
# DATABASE_URL mantiene sslmode=verify-full e omette sslrootcert se questa CA è presente.
DATABASE_CA_CERT_BASE64=
# 32 byte casuali in base64: node scripts/create-secret.mjs
SESSION_ENCRYPTION_KEY=
