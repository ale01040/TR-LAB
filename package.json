{
  "name": "tr-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "scripts": {
    "dev": "concurrently -k -n WEB,API \"npm run dev -w @tr-lab/web\" \"npm run dev -w @tr-lab/server\"",
    "preview": "node --env-file-if-exists=.env scripts/start-preview.mjs",
    "typecheck": "node scripts/style-types.mjs && tsc --noEmit -p tsconfig.json",
    "lint": "eslint apps packages tests scripts api",
    "format": "prettier --write apps packages tests scripts schemas examples api *.json *.mjs *.ts .github",
    "format:check": "prettier --check apps packages tests scripts schemas examples api *.json *.mjs *.ts .github",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test": "npm run test:unit && npm run test:integration",
    "build": "npm run typecheck && npm run build -w @tr-lab/web && npm run build -w @tr-lab/server && node scripts/build-vercel-function.mjs",
    "check:vercel": "node scripts/check-vercel-build.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run test:integration && npm run build && npm run check:vercel",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:verify": "vitest run tests/integration/database.test.ts",
    "contracts:check": "vitest run tests/unit/contracts.test.ts",
    "config:check": "node --env-file-if-exists=.env --import tsx scripts/check-config.ts",
    "db:preflight": "node --env-file-if-exists=.env --import tsx scripts/database-preflight.ts",
    "schema:generate": "node --import tsx scripts/create-standard-schema.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.1.2",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@supabase/supabase-js": "2.117.3",
    "@vercel/functions": "3.9.11",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "fastify": "5.12.5",
    "lucide-react": "1.55.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.5"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "supabase": "2.120.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
